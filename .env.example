# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Instagram fetching via Apify (apify.com -> Settings -> Integrations -> API token)
APIFY_TOKEN=

# Audio transcription via Deepgram (console.deepgram.com -> API Keys)
DEEPGRAM_API_KEY=

# Claude, for script cleanup + auto-tagging (console.anthropic.com)
ANTHROPIC_API_KEY=

# Password for the web UI
APP_PASSWORD=

# Bearer token for agents / shortcuts calling the API
API_KEY=
