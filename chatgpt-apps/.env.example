# Public HTTPS origin ChatGPT will call, no trailing slash. Download links are built from it.
PUBLIC_BASE_URL=https://apps.example.com

# Long random string; signs download links. `openssl rand -hex 32`
FILES_SECRET=

# Optional: serve only some apps from this process (default: all five)
# APPS=qr,calendar,timesheet,loan,citations

# Optional: contact email sent to Crossref/OpenAlex (gets you into their faster "polite" pool)
CONTACT_EMAIL=

PORT=8787
